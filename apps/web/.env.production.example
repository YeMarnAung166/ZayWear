# Copy to Vercel -> Project -> Environment Variables (Production).
# NEXT_PUBLIC_* values are baked at build time, so set them before deploying.
NEXT_PUBLIC_API_URL=https://<api>.up.railway.app/api
NEXT_PUBLIC_IMAGE_BASE=/mock

# Never set NEXT_PUBLIC_USE_MOCK in production: the build fails on purpose.
NEXT_PUBLIC_USE_MOCK=

# Errors only. The DSN is a public ingest key; leave empty to disable reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
