# Local development
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Where product images live. Mock SVGs ship in /public/mock.
NEXT_PUBLIC_IMAGE_BASE=/mock
# Set to 1 only for local UI work without the API running.
# Never set this in a production build: placeholder products cannot be ordered.
NEXT_PUBLIC_USE_MOCK=
# Leave empty locally to keep development errors out of the Sentry project.
NEXT_PUBLIC_SENTRY_DSN=

# Server-only admin credentials. Never prefix these with NEXT_PUBLIC_.
# ADMIN_TOKEN must match the Laravel API's ADMIN_TOKEN.
ADMIN_TOKEN=
# At least 32 random characters. Rotating it signs every admin out.
ADMIN_SESSION_SECRET=
