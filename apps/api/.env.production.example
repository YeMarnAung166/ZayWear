# Copy to Railway -> Variables (never commit the filled version).
# APP_URL is the Railway public domain; FRONTEND_URL is the Vercel domain.
APP_NAME=ZayWear
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<api>.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Emit one JSON object per line so Railway's log viewer and any collector can
# parse fields instead of guessing at a formatted string.
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Supabase -> Connect. Use the session pooler (port 5432) for migrations,
# dumps and restores; the transaction pooler (6543) is for high concurrency.
DB_CONNECTION=pgsql
DB_HOST=<project>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
# File cache keeps the rate limiter and the API response cache off the Tokyo
# round trip. Only one container runs, so a shared store is not needed.
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Three secrets that must never keep their local defaults.
ADMIN_PASSWORD=
ADMIN_TOKEN=
ORDER_TOKEN_SECRET=
ORDER_TOKEN_TTL_DAYS=90

TELEGRAM_BOT_USERNAME=zaywear_alerts_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=1631723326

FRONTEND_URL=https://<web>.vercel.app
CORS_ALLOWED_ORIGINS=https://<web>.vercel.app

# Error reporting only. Keep tracing at 0 so no performance transactions are
# billed and no request data is attached; PII stays off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

API_RATE_LIMIT_PER_MINUTE=300
ORDER_RATE_LIMIT_PER_MINUTE=10
TRACKING_RATE_LIMIT_PER_MINUTE=60
ADMIN_RATE_LIMIT_PER_MINUTE=30
