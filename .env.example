# ZayWear environment — copy to `.env` and fill in.
# Supabase: Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=slips

# Database (the backend Docker/compose overrides this; for local runs point it
# at your Supabase pooler URI, prefixed with +psycopg)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/apparel

# Telegram staff alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Business rules
EXCHANGE_WINDOW_DAYS=3

# Frontend (only needed for `npm run dev` outside Docker -> frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
